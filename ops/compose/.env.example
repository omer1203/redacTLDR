# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEMO_USER=demo-user
CLERK_SECRET_KEY=
CLERK_JWT_TEMPLATE=redactldr-api

# API
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/redactldr
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/redactldr
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_AUDIENCE=redactldr-api
# Comma-separated origins allowed to call the API from the browser (required when ENVIRONMENT is not local).
# CORS_ALLOWED_ORIGINS=https://app.example.com

UPLOAD_PRESIGN_TTL_SECONDS=600
MAX_UPLOAD_SIZE_BYTES=20971520

# AWS / storage (presigned uploads require bucket CORS — run scripts/apply-s3-cors.sh unless Terraform manages the bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_ORIGINALS=redactldr-originals-dev
S3_BUCKET_DOWNLOADS=redactldr-downloads-dev

# Optional worker model override
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional local observability; dev-up sets this automatically with
# `--profile observability` unless you override it here.
OTEL_EXPORTER_OTLP_ENDPOINT=
