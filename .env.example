# Shared
ENVIRONMENT=local
AWS_REGION=us-east-1
RETENTION_DAYS=7

# API + Worker runtime
API_PORT=8000
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BACKEND_URL=redis://redis:6379/1
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/redactldr

# AWS / S3 — use buckets that exist in your account (same region as AWS_REGION).
# Local dev: create with `aws s3 mb s3://… --region …` then run `bash scripts/apply-s3-cors.sh`
S3_BUCKET_ORIGINALS=redactldr-originals-dev
S3_BUCKET_DOWNLOADS=redactldr-downloads-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Clerk
CLERK_ISSUER_URL=https://your-issuer.clerk.accounts.dev
CLERK_JWKS_URL=https://your-issuer.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=redactldr-api
# Browser origins allowed to call the API (comma-separated). Required when ENVIRONMENT is not local.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_TEMPLATE=redactldr-api

# LLM
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Mobile app (use your machine's LAN IP when testing on a device)
# EXPO_PUBLIC_API_URL=http://192.168.1.x:8000
